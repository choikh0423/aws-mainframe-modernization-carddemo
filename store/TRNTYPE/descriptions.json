    {
      "kind": "module",
      "name": "TRNTYPE",
      "key_points": [
        "The transaction-type extension: it keeps transaction type and category reference data in DB2 with embedded static SQL, instead of the VSAM reference files the core application uses.",
        "Administrators maintain the types from CICS (CTLI, CTTU) and in batch, and an extract job feeds the data back to the VSAM side.",
        "It is an optional extension of CardDemo, reached from the core admin menu - COADM02Y names COTRTLIC and COTRTUPC."
      ],
      "basis": [
        "app/app-transaction-type-db2/README.md:8",
        "app/app-transaction-type-db2/README.md:24",
        "app/cpy/COADM02Y.cpy:49"
      ],
      "written_by": "agent"
    },
